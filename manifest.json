{
  "manifest_version": 3,
  "name": "Sentence Corrector",
  "version": "1.0.1",
  "description": "Correct grammatical mistakes in sentences.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16px.png",
      "32": "icons/32px.png",
      "48": "icons/48px.png",
      "64": "icons/64px.png",
      "128": "icons/128px.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/16px.png",
    "32": "icons/32px.png",
    "48": "icons/48px.png",
    "64": "icons/64px.png",
    "128": "icons/128px.png"
  }
}